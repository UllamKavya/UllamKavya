<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopKart</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Navbar -->
    <header>
        <div class="logo">ShopKart</div>

        <div class="search">
            <input type="text" placeholder="Search products...">
        </div>

        <nav>
            <a href="#">Home</a>
            <a href="#">Products</a>
